# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-min-32
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/docusuite

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage & Retention
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
TEMP_DIR=./storage/temp
OUTPUT_DIR=./storage/outputs
FILE_RETENTION_HOURS=24
CLEANUP_CRON_SCHEDULE="0 * * * *"

# Upload & Processing Limits
MAX_FILE_SIZE_BYTES=52428800 # 50 MB
MAX_FILES_PER_REQUEST=10
MAX_PAGES_PER_DOCUMENT=500
CONVERSION_TIMEOUT_MS=60000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
GUEST_DAILY_JOB_LIMIT=20

# Native Tool Paths (Optional - detected automatically if in PATH)
SOFFICE_PATH=
QPDF_PATH=
GS_PATH=
