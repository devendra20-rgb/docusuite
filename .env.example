# DocuSuite — Unified Docker Compose Configuration Environment Variables

# Service Ports
PORT=4000
FRONTEND_PORT=3000

# Public API URL (accessible from the user's browser on the host machine)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Security & Authentication (Change in production)
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-min-32
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# Ephemeral File Storage & Zero-Retention
STORAGE_DRIVER=local
FILE_RETENTION_HOURS=24
CLEANUP_CRON_SCHEDULE="0 * * * *"
MAX_FILE_SIZE_BYTES=52428800
MAX_FILES_PER_REQUEST=10
MAX_PAGES_PER_DOCUMENT=500
CONVERSION_TIMEOUT_MS=60000

# AWS S3 Storage (Optional - used when STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=docusuite/
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GUEST_DAILY_JOB_LIMIT=20
