# ---------------------------------------------------------------------------
# DocuSuite Monorepo Git Ignore
# ---------------------------------------------------------------------------

# Node Modules & Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Compiled Builds & Output Artifacts
backend/dist/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Storage Directories & Ephemeral User Data (Zero-Retention)
backend/storage/temp/*
backend/storage/outputs/*
!backend/storage/temp/.gitkeep
!backend/storage/outputs/.gitkeep

# Environment Files & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
backend/logs/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
